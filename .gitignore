# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android
local.properties
*.apk
*.aab
*.ap_
*.dex
.cxx/
captures/
output-metadata.json

# The engine is built out of the vendored tree in place, so its objects and
# libraries land inside it.
native/openevv/build/

# Rule bytecode, shims and decompiled parts are generated by the engine
# Makefile out of the lang/<tag>/rules text (see native/openevv/Makefile,
# RULECODE/GENERATED); the text rules are the source, these are not.
native/openevv/lang/*/delta_rules_*.c
native/openevv/lang/*/delta_rules_*.h
!native/openevv/lang/*/delta_rules_none_*.c

# Python tooling cache from the rule generators
__pycache__/
*.pyc

# Signing
*.jks
*.keystore
keystore.properties

# Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*~

# Operating systems
.DS_Store
Thumbs.db
desktop.ini
