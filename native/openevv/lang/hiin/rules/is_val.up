# Indo-Aryan consonant acoustic rules.
rule indi_ret_Fv takes 1 from is_val.obj
  call ZZfence_null
  set global half 2926 to 1550
  set global half 2930 to 1550
  set global half 2934 to 2050
  set global half 2938 to 2050
  set global half 2942 to 3150
  set global half 2946 to 3150
  match
end

rule indi_ph_M takes 1 from is_val.obj
  call ZZfence_null
  set global half 2918 to 300
  set global half 2922 to 300
  plant test m_fv
  call indi_ret_Fv
place m_fv
  set global half 2818 to 48
  set global half 2858 to 60
  set global half 2890 to 56
  set global half 2894 to 62
  set global half 2898 to 54
  match
end

rule indi_ph_W takes 1 from is_val.obj
  call ZZfence_null
  set global half 2918 to 200
  set global half 2922 to 200
  plant test w_fv
  call indi_ret_Fv
place w_fv
  plant test w_vb
  call do_ital_voice_bar
place w_vb
  set global half 2858 to 55
  set global half 2890 to 52
  set global half 2894 to 58
  match
end

