rule ital_con_vals takes 1 from is_val.obj
  call ZZfence_null
  plant test cv_1
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 2
    if answer is 0
      plant test cv_tail
      call ital_ph_p
      go to cv_tail
    end
  end
place cv_1
  plant test cv_2
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 1
    if answer is 0
      plant test cv_tail
