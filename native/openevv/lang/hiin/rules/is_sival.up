rule get_stanital_nuc_AV takes 1 from is_sival.obj
  call ZZfence_null
  set global half 2718 to 0
  set global half 2714 to 56
  call ZZlpta_load_vvg__setscan_0035r__2
  if answer is not 0
    go to av_adj
  end
  plant test av_open
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 27
  if answer is 0
    set global half 2714 to 57
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 31
  if answer is 0
    set global half 2714 to 57
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 61
  if answer is 0
    set global half 2714 to 56
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 62
  if answer is 0
    set global half 2714 to 56
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 71
  if answer is 0
    set global half 2714 to 56
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 72
  if answer is 0
    set global half 2714 to 57
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 73
  if answer is 0
    set global half 2714 to 56
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 74
  if answer is 0
    set global half 2714 to 57
    go to av_adj
  end
place av_open
  plant test av_adj
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 30
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 60
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 69
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 63
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 64
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 70
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 29
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 33
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 75
  if answer is 0
    set global half 2714 to 56
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 76
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 77
  if answer is 0
    set global half 2714 to 56
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 78
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
place av_adj
  plant test av_end
  call adjust_AV_for_fem_voice
place av_end
  if global half 2718 is 0
    set global half 2718 to global half 2714
    add -2 to global half 2718
  end
  match
end

