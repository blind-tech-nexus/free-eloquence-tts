    if answer is 0
      call advance_tok
      if answer is 0
        call testFldeq 2 4 5
        if answer is 0
          set global word 2628 to 72
        end
      end
    end
  end
place st_nonfin
  if global half 402 is 0
    set cell pct kind to 65532
    set cell pct field to 85
    plant test matched
    call setdur addr pct addr out_dur
  end
  match
