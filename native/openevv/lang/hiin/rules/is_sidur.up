# Authentic Indo-Aryan vowel nucleus start durations (ms in global word 2628).
rule assign_stanital_start_dur takes 3 from is_sidur.obj
  local dummy_a bytes 8
  local out_dur bytes 8
  local pct bytes 8

  call ZZget_parmINT addr dummy_a arg 1
  call ZZget_parmINT addr out_dur arg 2
  call ZZfence_null
  set global word 2628 to 120
  if global half 522 is 1
    set global word 2628 to 80
    go to check_vow_unst
  end
  plant test st_v_1
  call ZZlpta_load_vvg__setscan_0035r__2
  if answer is 0
    call testFldeq 2 0 60
    if answer is 0
      set global word 2628 to 72
      go to after_vow_st
    end
  end
