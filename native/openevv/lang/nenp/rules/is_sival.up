      call indi_vow_nc
      go to sv_tail
    end
  end
place sv_tail
  plant test sv_murmur_done
  call ZZlpta_load_vvg__setscan_0103l__2
  if answer is 0
    call testFldeq 2 0 59
    if answer is 0
      set global half 2914 to 7
      add 35 to global half 2726
      go to sv_murmur_done
    end
    call testFldeq 2 0 57
    if answer is 0
      set global half 2914 to 7
      add 30 to global half 2726
      go to sv_murmur_done
    end
  end
place sv_murmur_done
  plant test sv_ret_r
  call ZZlpta_load_vvg__setscan_0103l__2
  if answer is 0
    call testFldeq 2 5 4
    if answer is 0
      set global half 2934 to 2160
    end
  end
place sv_ret_r
  plant test sv_ret_done
  call ZZlpta_load_vvg__setscan_0104r__2
  if answer is 0
    call testFldeq 2 5 4
    if answer is 0
      set global half 2938 to 2160
    end
  end
place sv_ret_done
  plant test sv_nas
  if global half 3012 is 1
    call modify_breathiness_for_femV
  end
place sv_nas
  plant test sv_ins
  call nasalize_vow
place sv_ins
  plant test matched
  call insert_acoustic_vals
  match
end
