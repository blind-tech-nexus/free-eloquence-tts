rule get_stanital_nuc_AV takes 1 from is_sival.obj
  call ZZfence_null
  set global half 2718 to 0
  set global half 2714 to 53
  call ZZlpta_load_vvg__setscan_0035r__2
  if answer is not 0
    go to av_adj
  end
  # High vowels: i(27), u(31), I(61), U(62), nI(71), ni(72), nU(73), nu(74) -> 55
  plant test av_open
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 27
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 31
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 61
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 62
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 71
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 72
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 73
  if answer is 0
    set global half 2714 to 54
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 74
  if answer is 0
    set global half 2714 to 55
    go to av_adj
  end
place av_open
  # Low/open vowels: a(30)->48, E(29)->51, c(33)->51, O(63)->49, ae(64)->49, na(70)->49, nE(76)->51, nc(78)->51
  plant test av_adj
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 30
  if answer is 0
    set global half 2714 to 48
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 63
  if answer is 0
    set global half 2714 to 49
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 64
  if answer is 0
    set global half 2714 to 49
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 70
  if answer is 0
    set global half 2714 to 49
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 29
  if answer is 0
    set global half 2714 to 51
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 33
  if answer is 0
    set global half 2714 to 51
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 76
  if answer is 0
    set global half 2714 to 51
    go to av_adj
  end
  call ZZlpta_load_vvg__setscan_0035r__2
  call testFldeq 2 0 78
  if answer is 0
    set global half 2714 to 51
    go to av_adj
  end
place av_adj
  plant test av_end
  call adjust_AV_for_fem_voice
place av_end
  if global half 2718 is 0
    set global half 2718 to global half 2714
    add -2 to global half 2718
  end
  match
end

# Indo-Aryan vowel & nasalized vowel acoustic target rules.
rule indi_vow_schwa takes 1 from is_sival.obj
  call ZZfence_null
  plant test done
  set global half 2918 to 595
  set global half 2922 to 65535
  set global half 2926 to 1110
  set global half 2930 to 65535
  set global half 2934 to 2480
  set global half 2938 to 65535
  set global half 2726 to 100
  set global half 2730 to 95
  set global half 2734 to 130
place done
  match
end

