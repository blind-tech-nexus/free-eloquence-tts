place sv_17
  plant test sv_18
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 72
    if answer is 0
      plant test sv_tail
      call indi_vow_ni
      go to sv_tail
    end
  end
place sv_18
  plant test sv_19
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 73
    if answer is 0
      plant test sv_tail
      call indi_vow_nU
      go to sv_tail
    end
  end
place sv_19
  plant test sv_20
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 74
    if answer is 0
      plant test sv_tail
      call indi_vow_nu
      go to sv_tail
    end
  end
place sv_20
  plant test sv_21
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 75
    if answer is 0
      plant test sv_tail
      call indi_vow_ne
      go to sv_tail
    end
  end
place sv_21
  plant test sv_22
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 76
    if answer is 0
      plant test sv_tail
      call indi_vow_nE
      go to sv_tail
    end
  end
place sv_22
  plant test sv_23
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 77
    if answer is 0
      plant test sv_tail
      call indi_vow_no
      go to sv_tail
    end
  end
place sv_23
  plant test sv_tail
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 78
    if answer is 0
      plant test sv_tail
      call indi_vow_nc
      go to sv_tail
    end
  end
place sv_tail
  plant test sv_nas
  if global half 3012 is 1
    call modify_breathiness_for_femV
  end
place sv_nas
  plant test sv_ins
  call nasalize_vow
place sv_ins
  plant test matched
  call insert_acoustic_vals
  match
end
