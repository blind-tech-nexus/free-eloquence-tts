rule stanital_vals takes 1 from is_sival.obj
  call ZZfence_null
  plant test sv_1
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 27
    if answer is 0
      plant test sv_tail
      call stanital_ph_i
      go to sv_tail
    end
  end
place sv_1
  plant test sv_2
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 28
    if answer is 0
      plant test sv_tail
      call stanital_ph_e
      go to sv_tail
    end
  end
place sv_2
  plant test sv_3
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 29
    if answer is 0
      plant test sv_tail
      call indi_vow_E
      go to sv_tail
    end
  end
place sv_3
  plant test sv_4
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 30
    if answer is 0
      plant test sv_tail
      call indi_vow_a
      go to sv_tail
    end
  end
place sv_4
  plant test sv_5
