rule stanital_vals takes 1 from is_sival.obj
  call ZZfence_null
  plant test sv_1
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 27
    if answer is 0
      plant test sv_tail
      call indi_vow_i
      go to sv_tail
    end
  end
place sv_1
  plant test sv_2
  call ZZlpta_load_vvg__setscan_0103r__2
