# Expand affricates, aspirated/murmured stops, and falling diphthongs.
rule break_into_stanital_phones takes 1 from it_siphn.obj
  local cur bytes 8
  local nxt bytes 8
  local lim bytes 8

  call ZZpush_ptr_init3 addr cur addr nxt addr lim
  call ZZfence_null
  plant test matched as 1
  call ZZlpta_loadpn_vvg0087
  call ZZlpta_mover_2
  call lpta_storep addr cur
  call ZZlpta_loadpn_vvg0088
  call ZZlpta_mover_2
  call lpta_storep addr lim
  call forall_to_test addr cur addr lim
  if answer is not 0
    backtrack
  end
place loop_body on 3
  plant choice done_tok as 2
  call ZZlpta_load__setscan_r__2 addr cur
  if answer is not 0
    backtrack
  end
  call advance_tok
  if answer is not 0
    backtrack
  end
  call savescptr 4 addr nxt
place after_save on 4
  plant test exp_alt_1
  call ZZlpta_load__setscan_r__2 addr cur
  if answer is 0
    call testFldeq 2 0 14
    if answer is 0
      call lpta_rpta_loadp addr cur addr nxt
      call insert_2pt_s 2 2 sym exp_C 0
      if answer is 0
        call lpta_rpta_loadp addr cur addr nxt
        call mark_s 2 11 1 0
      end
      go to done_tok
    end
  end
place exp_alt_1
  plant test exp_alt_2
  call ZZlpta_load__setscan_r__2 addr cur
  if answer is 0
    call testFldeq 2 0 13
