      call lpta_rpta_loadp addr cur addr nxt
      call insert_2pt_s 2 2 sym exp_J 0
      if answer is 0
        call lpta_rpta_loadp addr cur addr nxt
        call mark_s 2 11 2 0
      end
      go to done_tok
    end
  end
place exp_alt_2
  plant test exp_alt_3
