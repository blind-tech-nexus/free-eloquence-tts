# Complete 1-byte SPR phoneme inserter for Indo-Aryan + base inventory.
rule insert_ital_spr_phone takes 3 from it_spr.obj
  local in_l bytes 8
  local ph_r bytes 8

  call ZZget_parm_ptr2 addr in_l arg 1 addr ph_r arg 2
  call ZZfence_null
  plant test arm_1
  call ZZlpta_load__setscan_r__1 addr in_l
  if answer is not 0
    go to arm_1
  end
  call testFldeq 1 0 75
  if answer is not 0
    go to arm_1
  end
  call advance_tok
  if answer is not 0
    go to arm_1
  end
  call ZZlpta_loadp__test_ptr addr ph_r
  if answer is not 0
    go to arm_1
  end
  call lpta_rpta_loadp addr in_l addr ph_r
  call insert_2pt_s 2 1 sym ph_gap 0
  if answer is 0
    match
  end
place arm_1
  plant test arm_2
  call ZZlpta_load__setscan_r__1 addr in_l
