rule ital_cons_durs takes 3 from is_dur.obj
  local p_start bytes 8
  local p_end bytes 8
  local lim bytes 8
  local g832
  local g840
  local g2080
  local g584

  set g832 to state
  add 832 to g832
  set g840 to state
  add 840 to g840
  set g2080 to state
  add 2080 to g2080
  set g584 to state
  add 584 to g584
  call ZZget_parm_ptr2 addr p_start arg 1 addr p_end arg 2
  call push_ptr_init addr lim
  call ZZfence_null
  plant test matched as 1
  call ZZlpta_load_move_storepr_2 addr p_start g832
  call ZZlpta_load_move_storepr_2 addr p_end addr lim
  call forall_to_test g832 addr lim
  if answer is not 0
    backtrack
  end
place cd_loop on 3
  plant choice cd_step as 2
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is not 0
    backtrack
  end
  call advance_tok
  if answer is not 0
