  end
  call savescptr 4 g840
place cd_saved on 4
  set global half 2990 to 0
  plant test cd_1
  call ZZlpta_load_vvg__setscan_0103r__2
  if answer is 0
    call testFldeq 2 0 25
    if answer is 0
      plant test cd_apply
      call ital_ph_y_dur
      go to cd_apply
    end
  end
place cd_1
