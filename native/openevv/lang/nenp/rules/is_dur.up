# Indo-Aryan consonant duration rules (nenp).
rule indi_ph_r_dur takes 1 from is_dur.obj
  call ZZfence_null
  set global half 2082 to 26
  plant test check_right
  call ZZlpta_load_vvg__setscan_0103l__2
  if answer is 0
    call testFldeq 2 0 21
    if answer is 0
      set global half 2082 to 18
      match
    end
  end
place check_right
  plant test check_gem
  call ZZlpta_load_vvg__setscan_0104r__2
  if answer is 0
    call testFldeq 2 0 21
    if answer is 0
      set global half 2082 to 48
      match
    end
  end
place check_gem
  match
end

